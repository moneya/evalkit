# Copy to .env and fill in what you need. .env is gitignored; this file is not,
# so it must never contain a real key.
#
#   cp .env.example .env
#
# evalkit loads the nearest .env at or above the working directory. Anything
# already in the real environment wins, so an inline KEY=... or a CI secret
# always beats this file. Use --no-env-file to ignore it entirely.
#
# No key is needed for the offline `echo` provider or for self-hosted servers
# such as Ollama and vLLM.

# --- hosted model providers (set only what you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# OpenAI-compatible gateways
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=

# --- optional overrides ---

# Point a provider at a proxy or a self-hosted server. The provider-specific
# form wins over the generic one.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# EVALKIT_BASE_URL=http://localhost:11434/v1

# Use your own pricing table instead of the bundled one.
# EVALKIT_PRICING=./evalkit-pricing.json

# Disable ANSI colour in reports (also honoured as the standard NO_COLOR).
# NO_COLOR=1

# Print which variables were loaded from .env (names only, never values).
# EVALKIT_DEBUG=1
